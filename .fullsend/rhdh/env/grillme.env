# Sandbox env for the grillme agent.
# Sourced at sandbox startup (no expand: true — bash runs this directly).
# GITHUB_ISSUE_URL and REPO_FULL_NAME are injected via env.sandbox in the
# harness; they are always available from dispatch context.

_issue_num="${GITHUB_ISSUE_URL##*/}"
export PR_NUMBER="${PR_NUMBER:-${_issue_num}}"
export ISSUE_NUMBER="${ISSUE_NUMBER:-${_issue_num}}"
export REPO_FULL_NAME="${REPO_FULL_NAME:-}"
export GITHUB_ISSUE_URL="${GITHUB_ISSUE_URL:-}"
export HUMAN_INSTRUCTION="${HUMAN_INSTRUCTION:-}"
export RUN_URL="${RUN_URL:-}"
export TRIGGER_SOURCE="${TRIGGER_SOURCE:-}"
