{
  "name": "@red-hat-developer-hub/backstage-plugin-app-defaults",
  "version": "1.6.0",
  "license": "Apache-2.0",
  "description": "RHDH app module for the new frontend system",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app-defaults-module": "./src/appDefaultsModuleExport.ts",
    "./app-drawer-module": "./src/appDrawerModuleExport.ts",
    "./app-sidebar-module": "./src/appSidebarModuleExport.ts",
    "./app-defaults-translations-module": "./src/appDefaultsTranslationsModuleExport.ts",
    "./catalog-plugin-override": "./src/catalogPluginOverrideExport.ts",
    "./catalog-graph-plugin-override": "./src/catalogGraphPluginOverrideExport.ts",
    "./scaffolder-plugin-override": "./src/scaffolderPluginOverrideExport.ts",
    "./api-docs-plugin-override": "./src/apiDocsPluginOverrideExport.ts",
    "./docs-plugin-override": "./src/docsPluginOverrideExport.ts",
    "./learning-paths-module": "./src/learningPathsModuleExport.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "app-defaults-module": [
        "src/appDefaultsModuleExport.ts"
      ],
      "app-drawer-module": [
        "src/appDrawerModuleExport.ts"
      ],
      "app-sidebar-module": [
        "src/appSidebarModuleExport.ts"
      ],
      "app-defaults-translations-module": [
        "src/appDefaultsTranslationsModuleExport.ts"
      ],
      "catalog-plugin-override": [
        "src/catalogPluginOverrideExport.ts"
      ],
      "catalog-graph-plugin-override": [
        "src/catalogGraphPluginOverrideExport.ts"
      ],
      "scaffolder-plugin-override": [
        "src/scaffolderPluginOverrideExport.ts"
      ],
      "api-docs-plugin-override": [
        "src/apiDocsPluginOverrideExport.ts"
      ],
      "docs-plugin-override": [
        "src/docsPluginOverrideExport.ts"
      ],
      "learning-paths-module": [
        "src/learningPathsModuleExport.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/app-defaults/plugins/app-defaults"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "app",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-app-defaults",
      "@red-hat-developer-hub/backstage-plugin-app-react"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-client": "^1.16.1",
    "@backstage/core-components": "^0.18.13",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@backstage/plugin-api-docs": "^0.14.4",
    "@backstage/plugin-app-react": "^0.2.6",
    "@backstage/plugin-catalog": "^2.0.8",
    "@backstage/plugin-catalog-common": "^1.1.10",
