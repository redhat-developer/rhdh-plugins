{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "AiResourceV1alpha1Agent",
  "description": "An AI resource of type 'agent', representing an autonomous or semi-autonomous AI agent with instructions and optional tool/handoff configuration.",
  "examples": [
    {
      "apiVersion": "backstage.io/v1alpha1",
      "kind": "AiResource",
      "metadata": {
        "name": "support-router-agent",
        "description": "Agent that routes support requests to specialist agents"
      },
      "spec": {
        "type": "agent",
        "lifecycle": "production",
        "owner": "ai-platform-team",
        "instructions": "You are a support router agent. Analyze incoming support requests and delegate them to the appropriate specialist agent."
      }
    }
  ],
  "allOf": [
    {
      "$ref": "Entity"
    },
    {
      "type": "object",
      "required": ["spec"],
      "properties": {
        "apiVersion": {
          "enum": ["backstage.io/v1alpha1"]
        },
        "kind": {
          "enum": ["AiResource"]
        },
        "spec": {
          "type": "object",
          "required": ["type", "lifecycle", "owner"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["agent"],
              "description": "The type of AI resource."
            },
            "lifecycle": {
              "type": "string",
              "description": "The lifecycle state of the AI resource.",
              "examples": ["experimental", "production", "deprecated"],
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "description": "An entity reference to the owner of the AI resource.",
              "examples": ["ai-platform-team", "user:john.johnson"],
              "minLength": 1
            },
            "system": {
              "type": "string",
              "description": "An entity reference to the system that the AI resource belongs to.",
              "minLength": 1
            },
            "instructions": {
              "type": "string",
              "description": "The agent's instructions (system prompt). Optional — omit when the agent image/runtime already provides a default prompt."
            },
            "handoffDescription": {
              "type": "string",
              "description": "A description used when this agent is listed as a handoff target.",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "description": "The model identifier for this agent.",
              "minLength": 1
            },
            "handoffs": {
              "type": "array",
              "description": "Opaque string references to other agents this agent can hand off to.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tools": {
              "type": "array",
              "description": "Opaque string references to tools available to this agent.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "toolUseBehavior": {
              "description": "Controls tool use behavior. A string preset or an array of tool names.",
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "resetToolChoice": {
              "type": "boolean",
              "description": "Whether to reset tool choice after each tool use."
            },
            "modelSettings": {
              "type": "object",
              "description": "Model configuration settings.",
              "properties": {
                "temperature": {
                  "type": "number",
                  "description": "Sampling temperature."
                },
                "maxTokens": {
                  "type": "number",
                  "description": "Maximum number of tokens to generate."
                },
                "toolChoice": {
                  "description": "Tool choice strategy.",
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "description": "JSON Schema object or simple type name describing the agent's output format.",
              "oneOf": [
                {
                  "type": "object"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          }
        }
      }
    }
  ]
}
