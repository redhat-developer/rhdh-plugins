{
  "name": "@red-hat-developer-hub/backstage-plugin-mcp-registry-server-mapping-common",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Common library that provides a deterministic transformation functions for transforming an MCP Registry server.json into Backstage mcp-server API entity (direct field mapping).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/ai-integrations/plugins/mcp-registry-server-mapping-common"
  },
  "backstage": {
    "role": "node-library",
    "pluginId": "mcp-registry-provider",
